# PostgreSQL Database URL (e.g. from Neon: https://console.neon.tech)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/scout_db?schema=public"

# JWT Secret Key
